# IG-App — Environment Variables Reference
# Copy this file and fill in your values.
# See ARCHITECTURE.md for details.

# ========================
# BACKEND (.env)
# ========================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ig-app
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# ========================
# FRONTEND (.env.local)
# ========================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=IG App

# ========================
# SUPERADMIN (.env.local)
# ========================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=IG App Admin
